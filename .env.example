# ==========================================
# OTPMAN SMS Telegram Bot Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. OTPMAN API Key (from SMS API page)
OTPMAN_API_KEY=your_otpman_api_key_here

# 3. OTPMAN API Base URL (default is https://augestel.com)
OTPMAN_BASE_URL=https://augestel.com

# 4. Primary Telegram Group Chat ID (e.g. -1001234567890)
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# 5. Secondary Telegram Group Chat ID (Optional - dual-group simultaneous delivery)
SECONDARY_GROUP_CHAT_ID=

# 6. Polling interval in seconds (5 req/min limit -> default 12.0s to 15.0s)
POLL_INTERVAL_SECONDS=12.0

# 7. Allowed Telegram Admin User IDs separated by commas (find with @userinfobot)
ADMIN_USER_IDS=your_telegram_user_id_here

# 8. GitHub Gist Token for 28h cloud persistence
GIST_TOKEN=your_gist_token_here

# 9. Gist ID (Optional — bot auto-creates or auto-discovers Gist)
GIST_ID=
